<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion, determinism, PathMap, embedded PDB, SourceLink off, ValheimDir/ManagedDir/BepInExCoreDir/PluginsDir
       and the game's BepInEx + 0Harmony + Jotunn references come from build\Valheim.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ValheimPlugin>true</ValheimPlugin>
    <ValheimUseJotunn>true</ValheimUseJotunn>
    <AssemblyName>FastStartup</AssemblyName>
    <RootNamespace>FastStartup</RootNamespace>
    <Product>FastStartup</Product>
    <Version>0.9.3</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- VNEI.dll targets net481; only its metadata is referenced (ModHotspots), the game runs it on Unity's Mono. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>

  <!--
    A preloader patcher is loaded before the chainloader, so it references the exact BepInEx/HarmonyX/MonoMod
    copies shipped in BepInEx\core (BepInEx + 0Harmony via the shared props) instead of NuGet packages.
    UnityEngine modules and assembly_valheim are referenced from the game; their types are only
    touched from code that runs after Chainloader.Initialize, never during the preloader.
  -->
  <ItemGroup>
    <Reference Include="BepInEx.Preloader">
      <HintPath>$(BepInExCoreDir)\BepInEx.Preloader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(BepInExCoreDir)\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(BepInExCoreDir)\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(BepInExCoreDir)\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only touched from code that runs after Chainloader.Initialize (never during the preloader). -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SoftReferenceableAssets">
      <HintPath>$(ManagedDir)\SoftReferenceableAssets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Third-party plugins for ModHotspots replacements: only touched after the plugin is found loaded and its IL
         fingerprint matched (ModHotspots\VneiIndexingFix.cs). Jotunn comes from ValheimUseJotunn. -->
    <Reference Include="VNEI">
      <HintPath>$(PluginsDir)\Vnei\VNEI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
